# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=123456:ABC-your-new-botfather-token
TELEGRAM_ADMIN_IDS=123456789
TELEGRAM_REPORT_CHAT_ID=123456789

# === DATABASE ===
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:PASSWORD@HOST:5432/postgres

# === APP ===
APP_TIMEZONE=Europe/Istanbul
DAILY_REPORT_HOUR=8
DAILY_REPORT_MINUTE=0
DAILY_TARGET_MIN=100
DAILY_TARGET_MAX=200
MIN_SOGO_SCORE=55

# === DASHBOARD ===
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-password
SECRET_KEY=change-this-to-a-random-long-string

# === WEBHOOK ===
USE_WEBHOOK=false
WEBHOOK_BASE_URL=https://your-deployed-domain.example.com
WEBHOOK_SECRET=change-this-webhook-secret
PORT=8000
