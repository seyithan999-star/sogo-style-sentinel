# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_REPORT_CHAT_ID=

# PostgreSQL / Supabase
# Prefer a Railway-reachable direct/session-pooler connection for migrations.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Runtime
APP_TIMEZONE=Europe/Istanbul
DAILY_REPORT_HOUR=8
DAILY_REPORT_MINUTE=0
DAILY_TARGET_MIN=100
DAILY_TARGET_MAX=200
MIN_SOGO_SCORE=55
SCAN_INTERVAL_MINUTES=30
REPORT_LOOKBACK_HOURS=24

# Optional licensed/authorized JSON web-search provider.
# Endpoint is intentionally configurable; no scraping bypass is built in.
SEARCH_PROVIDER_URL=
SEARCH_PROVIDER_KEY=
SEARCH_PROVIDER_MAX_QUERIES=30
SEARCH_PROVIDER_AUTH_HEADER=X-API-KEY

# Optional comma-separated official/manual color-trend palette.
MANUAL_COLOR_PALETTE=

# Dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-password
SECRET_KEY=change-this

# Telegram webhook (polling by default)
USE_WEBHOOK=false
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=change-this-webhook-secret
PORT=8000
